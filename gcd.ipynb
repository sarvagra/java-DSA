   "source": [
    "# recursive Euclidean algorithm\n",
    "def gcd(m, n):\n",
    "    m, n = abs(m), abs(n)\n",
    "    if n == 0:\n",
    "        return m\n",
    "    return gcd(n, m % n)\n",
    "\n",
    "print(gcd(6, 9))\n"
   ]
